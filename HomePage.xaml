<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YT_DLP_UI.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YT_DLP_UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16"
          RowSpacing="8">
        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Stretch"
                    Spacing="4"
                    VerticalAlignment="Top"
                    Grid.Row="1"
                    Grid.Column="1">
            <TextBlock Text="Enter a YouTube video, playlist, or channel link"
                       FontWeight="Medium"
                       FontSize="16"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- TextBox expands -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Button takes needed space -->
                </Grid.ColumnDefinitions>

                <TextBox x:Name="LinkTextBox"
                         AcceptsReturn="False"
                         TextWrapping="NoWrap"
                         PlaceholderText="https://youtu.be/..."
                         KeyUp="LinkTextBox_KeyUp"
                         HorizontalAlignment="Stretch"
                         Margin="4"
                         Grid.Column="0"/>
                <Button x:Name="DownloadButton"
                        Content="Download"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="DownloadButton_Click"
                        Margin="4"
                        Grid.Column="1"/>
            </Grid>

            <ProgressBar x:Name="DownloadProgressBar"
                         Visibility="Collapsed"
                         IsIndeterminate="True"
                         ShowPaused="False"
                         ShowError="False"/>

            <InfoBar x:Name="DownloadStatusInfoBar"
                     IsOpen="False">
                <InfoBar.ActionButton>
                    <Button x:Name="OpenDownloadButton"
                            Visibility="Collapsed"
                            Click="OpenDownloadButton_Click">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="3">
                            <FontIcon Glyph="&#xE8DA;"/>
                            <TextBlock Text="Open"/>
                        </StackPanel>
                    </Button>
                </InfoBar.ActionButton>
            </InfoBar>

            <Border Padding="12"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE8B7;"
                              FontSize="24"
                              VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Download destination"
                                   FontWeight="Medium"
                                   FontSize="16"/>
                        <TextBlock x:Name="PickDestinationOutputTextBlock"
                                   Text="No folder selected"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="12"/>
                    </StackPanel>
                    <Button x:Name="PickDestinationButton"
                            Click="PickDestinationButton_Click"
                            Grid.Column="2"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE70F;"/>
                    </Button>
                </Grid>
            </Border>

            <Border Padding="12"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xEA69;"
                              FontSize="24"
                              VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Format"
                                   FontWeight="Medium"
                                   FontSize="16"/>
                        <TextBlock Text="The file format the downloaded video will be saved as."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="12"/>
                    </StackPanel>
                    <ComboBox x:Name="FormatComboBox"
                              SelectionChanged="FormatComboBox_SelectionChanged"
                              IsEditable="True"
                              Grid.Column="2"
                              VerticalAlignment="Center">
                        <x:String>MP4</x:String>
                        <x:String>MP3</x:String>
                    </ComboBox>
                </Grid>
            </Border>

            <Expander HorizontalAlignment="Stretch"
                      Padding="12">
                <Expander.Header>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE9F5;"
                                  FontSize="24"
                                  VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Advanced options"
                                       FontWeight="Medium"
                                       FontSize="16"/>
                            <TextBlock FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="Settings intended for advanced users. See the"/>
                                <Hyperlink NavigateUri="https://github.com/yt-dlp/yt-dlp#usage-and-options"
                                           Foreground="{ThemeResource AccentFillColorDefaultBrush}">
                                    <Run Text="yt-dlp documentation"/>
                                </Hyperlink>
                                <Run Text="for details."/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <Expander.Content>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Additional command arguments"
                                   Grid.Column="0"/>
                        <TextBox x:Name="AdditionalArgumentsTextBox"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 LostFocus="AdditionalArgumentsTextBox_LostFocus"
                                 Grid.Column="1"/>
                    </Grid>
                </Expander.Content>
            </Expander>
        </StackPanel>

        <ProgressRing x:Name="SavingSettingsProgressRing"
                      IsActive="False"/>
    </Grid>
</Page>
