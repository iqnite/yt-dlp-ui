<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YT_DLP_UI.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YT_DLP_UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16"
          RowSpacing="8">
        <ScrollView>
            <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Stretch"
                    Spacing="4"
                    VerticalAlignment="Top"
                    Grid.Row="1"
                    Grid.Column="1">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <!-- TextBox expands -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Button takes needed space -->
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="LinkTextBox"
                         AcceptsReturn="False"
                         TextWrapping="NoWrap"
                         PlaceholderText="Enter a video, song, playlist, or channel link"
                         KeyUp="LinkTextBox_KeyUp"
                         TextChanged="LinkTextBox_TextChanged"
                         HorizontalAlignment="Stretch"
                         Margin="4"
                         Grid.Column="0"/>
                    <Button x:Name="DownloadButton"
                        Content="Paste and Download"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="DownloadButton_Click"
                        Margin="4"
                        Grid.Column="1"/>
                </Grid>

                <ProgressBar x:Name="DownloadProgressBar"
                         Visibility="Collapsed"
                         IsIndeterminate="True"
                         ShowPaused="False"
                         ShowError="False"/>

                <InfoBar x:Name="DownloadStatusInfoBar"
                     IsOpen="False">
                    <InfoBar.ActionButton>
                        <Button x:Name="OpenDownloadButton"
                            Visibility="Collapsed"
                            Click="OpenDownloadButton_Click">
                            <StackPanel Orientation="Horizontal"
                                    Spacing="3">
                                <FontIcon Glyph="&#xE8DA;"/>
                                <TextBlock Text="Show"/>
                            </StackPanel>
                        </Button>
                    </InfoBar.ActionButton>
                </InfoBar>

                <Border Padding="12"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE8B7;"
                              FontSize="24"
                              VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Download destination"
                                   FontWeight="Medium"
                                   FontSize="16"/>
                            <HyperlinkButton x:Name="PickDestinationOutputTextBlock"
                                   Content="No folder selected"
                                   Click="OpenDownloadButton_Click"
                                   FontSize="12"
                                   Padding="0"/>
                        </StackPanel>
                        <Button x:Name="PickDestinationButton"
                            Content="Change folder"
                            Click="PickDestinationButton_Click"
                            Grid.Column="2"
                            VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Padding="12"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xEA69;"
                              FontSize="24"
                              VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Format"
                                   FontWeight="Medium"
                                   FontSize="16"/>
                            <TextBlock Text="The file format the downloaded video will be saved as."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="12"/>
                        </StackPanel>
                        <ComboBox x:Name="FormatComboBox"
                              SelectionChanged="SaveSettingsUI"
                              IsEditable="False"
                              Grid.Column="2"
                              SelectedItem="{x:Bind Path=Settings.Format, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right">
                            <x:String>mp4</x:String>
                            <x:String>mp3</x:String>
                            <x:String>Advanced</x:String>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Padding="12"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE8EC;"
                              FontSize="24"
                              VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Embed Metadata"
                                   FontWeight="Medium"
                                   FontSize="16"/>
                            <TextBlock Text="Add thumbnail, subtitles, author, and other information to the downloaded file."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="12"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="EmbedMetadataToggle"
                              Toggled="EmbedMetadataToggle_Toggled"
                              Grid.Column="2"
                              IsOn="{x:Bind Path=Settings.EmbedMetadata, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right"
                              HorizontalContentAlignment="Right"
                              MinWidth="0"/>
                    </Grid>
                </Border>

                <Expander HorizontalAlignment="Stretch"
                      Padding="12">
                    <Expander.Header>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Glyph="&#xE9F5;"
                                  FontSize="24"
                                  VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Advanced options"
                                       FontWeight="Medium"
                                       FontSize="16"/>
                                <TextBlock FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
									<Run Text="Settings intended for advanced users. See the"/>
									<Hyperlink NavigateUri="https://github.com/yt-dlp/yt-dlp#usage-and-options"
											   Foreground="{ThemeResource AccentFillColorDefaultBrush}">
										<Run Text="yt-dlp documentation"/>
									</Hyperlink>
									<Run Text="for details."/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <Expander.Content>
                        <StackPanel Orientation="Vertical" Spacing="12">
                            <TextBlock Text="Additional command arguments"/>
                            <TextBox x:Name="AdditionalArgumentsTextBox"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 Text="{x:Bind Path=Settings.AdditionalArguments, Mode=TwoWay}"
                                 />
                            <ToggleSwitch x:Name="UseSystemFFMPEGToggle"
                                        Header="Use system ffmpeg"
                                        IsOn="{x:Bind Path=Settings.UseSystemFFMPEG, Mode=TwoWay}"
                                      />
                            <Button x:Name="SaveSettingsButton"
                                Content="Save"
                                Click="SaveSettingsUI"
                                />
                        </StackPanel>
                    </Expander.Content>
                </Expander>

                <Expander HorizontalAlignment="Stretch" Padding="12">
                    <Expander.Header>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Glyph="&#xE946;" FontSize="24" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="About" FontWeight="Medium" FontSize="16"/>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <Expander.Content>
                        <StackPanel Orientation="Vertical" Spacing="12">
                            <TextBlock>Version: 1.0.35</TextBlock>
                            <TextBlock>
                            <Hyperlink NavigateUri="https://github.com/iqnite/yt-dlp-ui"
										   Foreground="{ThemeResource AccentFillColorDefaultBrush}">
                                Wyder Video Downloader on GitHub
                            </Hyperlink>
                            </TextBlock>
                            <TextBlock FontWeight="Bold">
                                Third-party software used:
                            </TextBlock>
                            <TextBlock>
                                <Hyperlink NavigateUri="https://github.com/yt-dlp/yt-dlp"
										       Foreground="{ThemeResource AccentFillColorDefaultBrush}">
                                    yt-dlp
                                </Hyperlink>
                                (<Hyperlink NavigateUri="https://github.com/yt-dlp/yt-dlp/blob/master/LICENSE" Foreground="{ThemeResource AccentFillColorDefaultBrush}">
                                    License
                                </Hyperlink>)
                            </TextBlock>
                            <TextBlock>
                                <Hyperlink NavigateUri="https://www.ffmpeg.org/"
										       Foreground="{ThemeResource AccentFillColorDefaultBrush}">
                                    ffmpeg
                                </Hyperlink>
                                (<Hyperlink NavigateUri="https://github.com/yt-dlp/FFmpeg-Builds/blob/master/LICENSE" Foreground="{ThemeResource AccentFillColorDefaultBrush}">
                                    License
                                </Hyperlink>)
                            </TextBlock>
                            <TextBlock>
                                <Hyperlink NavigateUri="https://deno.com/"
										       Foreground="{ThemeResource AccentFillColorDefaultBrush}">
                                    Deno
                                </Hyperlink>
                                (<Hyperlink NavigateUri="https://github.com/denoland/deno/blob/main/LICENSE.md" Foreground="{ThemeResource AccentFillColorDefaultBrush}">
                                    License
                                </Hyperlink>)
                            </TextBlock>
                            <TextBlock>
                                <Hyperlink NavigateUri="https://learn.microsoft.com/en-us/windows/apps/winui/winui3/"
										       Foreground="{ThemeResource AccentFillColorDefaultBrush}">
                                    WinUI 3
                                </Hyperlink>
                                (<Hyperlink NavigateUri="https://learn.microsoft.com/en-us/windows/apps/winui/winui2/license" Foreground="{ThemeResource AccentFillColorDefaultBrush}">
                                    License
                                </Hyperlink>)
                            </TextBlock>
                            <TextBlock FontWeight="Bold">
                                2025 - 2026 by
                                <Hyperlink NavigateUri="https://iqnite.github.io/"
                                           Foreground="{ThemeResource AccentFillColorDefaultBrush}">
                                    phorb
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Expander.Content>
                </Expander>
            </StackPanel>
        </ScrollView>

        <ProgressRing x:Name="SavingSettingsProgressRing"
                      IsActive="False"/>
    </Grid>
</Page>
